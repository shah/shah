# The CLI Workshop (workshop/ in this repository), as the model of record.
# ontology/check.ts fails when workshop/snshah.ts, the bootstraps or this
# file disagree, so change them together.

@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix doap:    <http://usefulinc.com/ns/doap#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eid:     <https://github.com/shah/shah/ontology/eidolon#> .
@prefix ws:      <https://github.com/shah/shah/ontology/workshop#> .

ws:snshah a ws:Toolkit ;
    rdfs:label "Workshop (snshah)" ;
    rdfs:comment "Shahid Shah's shell and creature comforts for all work at the CLI." ;
    doap:programming-language "TypeScript" ;
    dcterms:creator "Shahid Shah" ;
    eid:path "workshop/snshah.ts" ;
    ws:version "0.7.1" ;
    ws:idempotent true ;
    ws:runtime ws:bun ;
    ws:upstream "shah/shah@main" ;
    ws:workspacesVariable "WORKSPACES_HOME" ;
    ws:workspacesDefault "~/workspaces" ;
    ws:selfCheckout "shah" ;
    ws:updateCheckInterval "PT1H"^^xsd:duration ;
    ws:doctorOnFirstShell true ;
    ws:bootstrap ws:bootstrap-sh , ws:bootstrap-ps1 ;
    ws:theme ws:theme-omp ;
    ws:supportsPlatform ws:platform-linux , ws:platform-wsl , ws:platform-macos , ws:platform-windows ;
    ws:emitsFor ws:shell-bash , ws:shell-zsh , ws:shell-fish , ws:shell-pwsh ;
    ws:secretScope ws:scope-command , ws:scope-shell ;
    ws:makesStep ws:step-directory , ws:step-file , ws:step-seed , ws:step-block , ws:step-json-fill , ws:step-toml-fill ,
        ws:step-remove , ws:step-command , ws:step-download , ws:step-tools ;
    ws:selectsBy ws:selector-always , ws:selector-platform , ws:selector-distro , ws:selector-omarchy , ws:selector-has , ws:selector-env , ws:selector-hostname , ws:selector-machine , ws:selector-all , ws:selector-any , ws:selector-not ;
    ws:hooksWith ws:hook-file , ws:hook-block , ws:hook-command ;
    ws:hasProfile ws:profile-10-omarchy ,
        ws:profile-20-debian-bat ,
        ws:profile-20-debian-fd ,
        ws:profile-20-fedora ,
        ws:profile-30-macos ,
        ws:profile-30-windows ,
        ws:profile-30-wsl ;
    ws:installs ws:bin-oh-my-posh , ws:bin-mise ;
    ws:toolManager ws:bin-mise ;
    ws:defaultTool "gh" , "ripgrep" , "fd" , "bat" , "fzf" , "jq" , "yq" , "delta" , "direnv" , "eza" ;
    ws:directoryProfileFile ".snshah.profile.ts" ;
    ws:clientOsVariable "LC_SNSHAH_OS" ;
    ws:sshHintSilencedBy "SNSHAH_SSH_HINT" ;
    ws:advisesWith ws:pm-apt , ws:pm-dnf , ws:pm-pacman , ws:pm-apk , ws:pm-zypper , ws:pm-brew , ws:pm-winget , ws:pm-omarchy ;
    ws:dependsOn ws:dep-commander , ws:dep-chalk , ws:dep-clack ;
    ws:usesPath ws:path-config , ws:path-types , ws:path-profiles , ws:path-script , ws:path-repoProfiles , ws:path-theme ,
        ws:path-posh , ws:path-mise , ws:path-receipt , ws:path-state , ws:path-downloads , ws:path-bin ;
    ws:hasCommand ws:cmd-plan , ws:cmd-whoami , ws:cmd-apply , ws:cmd-doctor , ws:cmd-shell , ws:cmd-exec ,
        ws:cmd-config-path , ws:cmd-config-check , ws:cmd-config-edit , ws:cmd-config-set-secret ,
        ws:cmd-git-root , ws:cmd-git-add , ws:cmd-git-list , ws:cmd-git-path , ws:cmd-git-clone , ws:cmd-git-update , ws:cmd-git-remove ,
        ws:cmd-ssh-status , ws:cmd-ssh-keys , ws:cmd-ssh-new , ws:cmd-ssh-copy , ws:cmd-ssh-authorize , ws:cmd-ssh-authorized , ws:cmd-ssh-test , ws:cmd-ssh-harden , ws:cmd-ssh-host-add , ws:cmd-ssh-host-list , ws:cmd-ssh-host-remove , ws:cmd-profile-list , ws:cmd-profile-prune , ws:cmd-profile-show , ws:cmd-profile-allow , ws:cmd-profile-deny , ws:cmd-profile-init , ws:cmd-profile-check , ws:cmd-profile-why , ws:cmd-profile-load , ws:cmd-ux-fonts-status , ws:cmd-ux-fonts-installed , ws:cmd-ux-fonts-missing , ws:cmd-ux-fonts-reset , ws:cmd-ux-fonts-install , ws:cmd-uninstall , ws:cmd-update , ws:cmd-test .

ws:bun a ws:Runtime ; rdfs:label "Bun" ; ws:minimumVersion "1.4.0" .

# ---------- Bootstraps and theme ----------
ws:bootstrap-sh a ws:BootstrapScript ; rdfs:label "POSIX sh bootstrap (Linux, WSL, macOS)" ;
    eid:path "workshop/bootstrap.sh" ; ws:pinsBun "1.4.4" ; ws:idempotent true .
ws:bootstrap-ps1 a ws:BootstrapScript ; rdfs:label "PowerShell bootstrap (Windows 11+)" ;
    eid:path "workshop/bootstrap.ps1" ; ws:pinsBun "1.4.4" ; ws:idempotent true .
ws:theme-omp a ws:Theme ; rdfs:label "Oh My Posh theme" ; eid:path "workshop/snshah.omp.json" .

# ---------- Commands ----------
ws:cmd-plan a ws:Command ; ws:name "plan" ; rdfs:comment "Read-only: the steps apply would take." .
ws:cmd-whoami a ws:Command ; ws:name "whoami" ; rdfs:comment "Print the facts profile.d selectors match against." .
ws:cmd-apply a ws:Command ; ws:name "apply" ; rdfs:comment "Converge to the desired state; a second run changes nothing." .
ws:cmd-doctor a ws:Command ; ws:name "doctor" ; rdfs:comment "Detect tools and advise installs; never installs." .
ws:cmd-shell a ws:Command ; ws:name "shell" ;
    rdfs:comment "Print init code for one shell. With --greet (what startup files pass), also run doctor on the first shell of each version and the hourly background update check." .
ws:cmd-exec a ws:Command ; ws:name "exec" ; rdfs:comment "Run a command with its command-scoped secrets." .
ws:cmd-config-path a ws:Command ; ws:name "config path" .
ws:cmd-config-check a ws:Command ; ws:name "config check" .
ws:cmd-config-edit a ws:Command ; ws:name "config edit" .
ws:cmd-config-set-secret a ws:Command ; ws:name "config set-secret" .
ws:cmd-git-root a ws:Command ; ws:name "git root" .
ws:cmd-git-add a ws:Command ; ws:name "git add" .
ws:cmd-git-list a ws:Command ; ws:name "git list" .
ws:cmd-git-path a ws:Command ; ws:name "git path" .
ws:cmd-git-clone a ws:Command ; ws:name "git clone" .
ws:cmd-git-update a ws:Command ; ws:name "git update" .
ws:cmd-git-remove a ws:Command ; ws:name "git remove" .
ws:cmd-ssh-status a ws:Command ; ws:name "ssh status" ; rdfs:comment "Show this session: how you logged in, where from, and the keys involved. The default ssh command." .
ws:cmd-ssh-keys a ws:Command ; ws:name "ssh keys" ; rdfs:comment "List the public keys in ~/.ssh with fingerprints." .
ws:cmd-ssh-new a ws:Command ; ws:name "ssh new" ; rdfs:comment "Create an ed25519 key when none exists." .
ws:cmd-ssh-copy a ws:Command ; ws:name "ssh copy" ; rdfs:comment "Show how to copy a public key to this machine from Linux, macOS or Windows; just the client's OS when it is known." .
ws:cmd-ssh-authorize a ws:Command ; ws:name "ssh authorize" ; rdfs:comment "Add a public key (a file, stdin, or github.com/<user>.keys) to authorized_keys, idempotently." .
ws:cmd-ssh-authorized a ws:Command ; ws:name "ssh authorized" ; rdfs:comment "List the keys that can log in here." .
ws:cmd-ssh-test a ws:Command ; ws:name "ssh test" ; rdfs:comment "Check that key login works to a target." .
ws:cmd-ssh-harden a ws:Command ; ws:name "ssh harden" ; rdfs:comment "Advice only: print the sshd changes that turn off password login. Never runs them." .
ws:cmd-ssh-host-add a ws:Command ; ws:name "ssh host add" ; rdfs:comment "Write one marked Host block to ~/.ssh/config." .
ws:cmd-ssh-host-list a ws:Command ; ws:name "ssh host list" ; rdfs:comment "List the Host blocks snshah wrote." .
ws:cmd-ssh-host-remove a ws:Command ; ws:name "ssh host remove" ; rdfs:comment "Remove one Host block snshah wrote." .
ws:cmd-profile-list a ws:Command ; ws:name "profile list" ; rdfs:comment "Find .snshah.profile.ts files here, above and below (with --all, in workspaces and checkouts) and show which are trusted. Alias ls. The default profile command." .
ws:cmd-profile-prune a ws:Command ; ws:name "profile prune" ; rdfs:comment "Forget trust for directory profiles whose file no longer exists." .
ws:cmd-profile-show a ws:Command ; ws:name "profile show" ; rdfs:comment "What the trusted directory profiles set here, and which file set it." .
ws:cmd-profile-allow a ws:Command ; ws:name "profile allow" ; rdfs:comment "Read a directory profile, then trust its content hash. Alias: safe." .
ws:cmd-profile-deny a ws:Command ; ws:name "profile deny" ; rdfs:comment "Stop trusting a directory profile." .
ws:cmd-profile-init a ws:Command ; ws:name "profile init" ; rdfs:comment "Create a .snshah.profile.ts in this directory; never overwrites." .
ws:cmd-profile-check a ws:Command ; ws:name "profile check" ; rdfs:comment "Validate a trusted directory profile." .
ws:cmd-profile-why a ws:Command ; ws:name "profile why" ; rdfs:comment "Which directory profile sets an alias, variable or PATH entry." .
ws:cmd-profile-load a ws:Command ; ws:name "profile load" ; rdfs:comment "Internal: the shell code the prompt hook evaluates for the trusted profiles." .
ws:cmd-ux-fonts-status a ws:Command ; ws:name "ux fonts status" ; rdfs:comment "Show whether your terminal has a Nerd Font and how snshah knows." .
ws:cmd-ux-fonts-installed a ws:Command ; ws:name "ux fonts installed" ; rdfs:comment "Record that your terminal shows the prompt icons correctly." .
ws:cmd-ux-fonts-missing a ws:Command ; ws:name "ux fonts missing" ; rdfs:comment "Record that your terminal has no Nerd Font." .
ws:cmd-ux-fonts-reset a ws:Command ; ws:name "ux fonts reset" ; rdfs:comment "Forget your answer; doctor shows unknown." .
ws:cmd-ux-fonts-install a ws:Command ; ws:name "ux fonts install" ; rdfs:comment "Show, or with --run do, oh-my-posh font install Meslo." .
ws:cmd-update a ws:Command ; ws:name "update" ; rdfs:comment "Fetch the install checkout, preview the plan from a temporary worktree, fast-forward it, then apply from it." .
ws:cmd-uninstall a ws:Command ; ws:name "uninstall" ; rdfs:comment "Remove snshah: startup blocks, launcher, installed copy, state and cache. Previews unless --yes; --purge also deletes the private config." .
ws:cmd-test a ws:Command ; ws:name "test" ; rdfs:comment "Self-test in a temporary HOME." .

# ---------- Controlled values ----------
ws:platform-linux a ws:Platform ; ws:name "linux" ; rdfs:label "Linux, any distribution" .
ws:platform-wsl a ws:Platform ; ws:name "wsl" ; rdfs:label "Windows Subsystem for Linux" .
ws:platform-macos a ws:Platform ; ws:name "macos" ; rdfs:label "macOS" .
ws:platform-windows a ws:Platform ; ws:name "windows" ; rdfs:label "Windows 11 and later" .

ws:shell-bash a ws:ShellTarget ; ws:name "bash" .
ws:shell-zsh a ws:ShellTarget ; ws:name "zsh" .
ws:shell-fish a ws:ShellTarget ; ws:name "fish" .
ws:shell-pwsh a ws:ShellTarget ; ws:name "pwsh" .

ws:scope-command a ws:SecretScope ; ws:name "command" ;
    rdfs:comment "Reaches only the listed commands, through snshah exec or its wrapper function." .
ws:scope-shell a ws:SecretScope ; ws:name "shell" ;
    rdfs:comment "Also exported into every interactive shell." .

ws:step-directory a ws:StepKind ; ws:name "directory" .
ws:step-file a ws:StepKind ; ws:name "file" ; rdfs:comment "A file snshah owns outright." .
ws:step-seed a ws:StepKind ; ws:name "seed" ; rdfs:comment "Created once, then never overwritten (the private config)." .
ws:step-block a ws:StepKind ; ws:name "block" ; rdfs:comment "One marked block inside a file the user owns." .
ws:step-json-fill a ws:StepKind ; ws:name "json-fill" ; rdfs:comment "Adds unset JSON keys only." .
ws:step-toml-fill a ws:StepKind ; ws:name "toml-fill" ; rdfs:comment "Adds unset TOML keys only." .
ws:step-remove a ws:StepKind ; ws:name "remove" ; rdfs:comment "Deletes a file snshah installed and no longer ships (a retired repo profile)." .
ws:step-command a ws:StepKind ; ws:name "command" ; rdfs:comment "A profile command hook; planned only while its unless check fails." .
ws:step-tools a ws:StepKind ; ws:name "tools" ; rdfs:comment "Runs mise install for the tool list; the last apply step, and it fails if a tool is still missing." .
ws:step-download a ws:StepKind ; ws:name "download" ; rdfs:comment "Installs a pinned, SHA-256 checked release file snshah owns." .

# ---------- profile.d ----------
ws:selector-always a ws:SelectorKind ; ws:name "always" .
ws:selector-platform a ws:SelectorKind ; ws:name "platform" .
ws:selector-distro a ws:SelectorKind ; ws:name "distro" .
ws:selector-omarchy a ws:SelectorKind ; ws:name "omarchy" .
ws:selector-has a ws:SelectorKind ; ws:name "has" .
ws:selector-env a ws:SelectorKind ; ws:name "env" .
ws:selector-hostname a ws:SelectorKind ; ws:name "hostname" ; ws:privateOnly true .
ws:selector-machine a ws:SelectorKind ; ws:name "machine" .
ws:selector-all a ws:SelectorKind ; ws:name "all" .
ws:selector-any a ws:SelectorKind ; ws:name "any" .
ws:selector-not a ws:SelectorKind ; ws:name "not" .

ws:hook-file a ws:HookKind ; ws:name "file" ; rdfs:comment "A file the profile owns outright." .
ws:hook-block a ws:HookKind ; ws:name "block" ; rdfs:comment "One marked block per profile inside a file the user owns." .
ws:hook-command a ws:HookKind ; ws:name "command" ; rdfs:comment "Runs before or after apply only while its required unless check fails." .

ws:profile-10-omarchy a ws:Profile ; ws:name "10-omarchy" ; eid:path "workshop/profile.d/10-omarchy.ts" ;
    ws:selectorKind ws:selector-omarchy ; rdfs:comment "Omarchy keeps work under ~/Work. $WORKSPACES_HOME and snshah.conf.ts still win." .
ws:profile-20-debian-bat a ws:Profile ; ws:name "20-debian-bat" ; eid:path "workshop/profile.d/20-debian-bat.ts" ;
    ws:selectorKind ws:selector-all ; rdfs:comment "Debian and Ubuntu ship bat as `batcat`; use the upstream name when it is free." .
ws:profile-20-debian-fd a ws:Profile ; ws:name "20-debian-fd" ; eid:path "workshop/profile.d/20-debian-fd.ts" ;
    ws:selectorKind ws:selector-all ; rdfs:comment "Debian and Ubuntu ship fd as `fdfind`; use the upstream name when it is free." .
ws:profile-20-fedora a ws:Profile ; ws:name "20-fedora" ; eid:path "workshop/profile.d/20-fedora.ts" ;
    ws:selectorKind ws:selector-distro ; rdfs:comment "Fedora and its relatives: one alias for a full refresh-and-upgrade." .
ws:profile-30-macos a ws:Profile ; ws:name "30-macos" ; eid:path "workshop/profile.d/30-macos.ts" ;
    ws:selectorKind ws:selector-platform ; rdfs:comment "Homebrew on Apple silicon lives in /opt/homebrew, which login shells may not have on PATH." .
ws:profile-30-windows a ws:Profile ; ws:name "30-windows" ; eid:path "workshop/profile.d/30-windows.ts" ;
    ws:selectorKind ws:selector-platform ; rdfs:comment "Windows PowerShell: `which` for people with Unix fingers. Other shells get nothing." .
ws:profile-30-wsl a ws:Profile ; ws:name "30-wsl" ; eid:path "workshop/profile.d/30-wsl.ts" ;
    ws:selectorKind ws:selector-platform ; rdfs:comment "WSL: reach the Windows clipboard and Explorer with familiar names." .

ws:bin-oh-my-posh a ws:PinnedBinary ; ws:name "oh-my-posh" ; ws:pinnedVersion "33.4.1" ;
    rdfs:comment "Installed under $XDG_DATA_HOME/snshah/bin only when no oh-my-posh is on PATH and the prompt allows it." .

ws:bin-mise a ws:PinnedBinary ; ws:name "mise" ; ws:pinnedVersion "2026.11.14" ;
    rdfs:comment "Developer tool manager, on by default (toolManager: none turns it off). Installed under $XDG_DATA_HOME/snshah/bin only when no mise is on PATH." .

ws:pm-apt a ws:PackageManager ; ws:name "apt" .
ws:pm-dnf a ws:PackageManager ; ws:name "dnf" .
ws:pm-pacman a ws:PackageManager ; ws:name "pacman" .
ws:pm-apk a ws:PackageManager ; ws:name "apk" .
ws:pm-zypper a ws:PackageManager ; ws:name "zypper" .
ws:pm-brew a ws:PackageManager ; ws:name "brew" .
ws:pm-winget a ws:PackageManager ; ws:name "winget" .
ws:pm-omarchy a ws:PackageManager ; ws:name "omarchy" .

ws:dep-commander a ws:Dependency ; ws:name "commander" ; ws:pinnedVersion "12.1.0" .
ws:dep-chalk a ws:Dependency ; ws:name "chalk" ; ws:pinnedVersion "5.6.2" .
ws:dep-clack a ws:Dependency ; ws:name "@clack/prompts" ; ws:pinnedVersion "0.11.0" .

# ---------- Strict XDG paths ----------
ws:path-config a ws:XdgPath ; ws:name "config" ; ws:xdgBase "XDG_CONFIG_HOME" ; ws:fallback ".config" ; ws:relativePath "snshah/snshah.conf.ts" ;
    rdfs:comment "Private, mode 0600, never in Git." .
ws:path-profiles a ws:XdgPath ; ws:name "profiles" ; ws:xdgBase "XDG_CONFIG_HOME" ; ws:fallback ".config" ; ws:relativePath "snshah/profile.d" ;
    rdfs:comment "Private profile.d: may use hostname and machine selectors and secrets." .
ws:path-repoProfiles a ws:XdgPath ; ws:name "repoProfiles" ; ws:xdgBase "XDG_DATA_HOME" ; ws:fallback ".local/share" ; ws:relativePath "snshah/profile.d" ;
    rdfs:comment "Installed copy of workshop/profile.d." .
ws:path-state a ws:XdgPath ; ws:name "state" ; ws:xdgBase "XDG_STATE_HOME" ; ws:fallback ".local/state" ; ws:relativePath "snshah/state.json" ;
    rdfs:comment "Typed runtime state: which version already ran doctor, and the last update check." .
ws:path-posh a ws:XdgPath ; ws:name "posh" ; ws:xdgBase "XDG_DATA_HOME" ; ws:fallback ".local/share" ; ws:relativePath "snshah/bin/oh-my-posh" .
ws:path-mise a ws:XdgPath ; ws:name "mise" ; ws:xdgBase "XDG_DATA_HOME" ; ws:fallback ".local/share" ; ws:relativePath "snshah/bin/mise" .
ws:path-types a ws:XdgPath ; ws:name "types" ; ws:xdgBase "XDG_CONFIG_HOME" ; ws:fallback ".config" ; ws:relativePath "snshah/snshah.auto.d.ts" .
ws:path-script a ws:XdgPath ; ws:name "script" ; ws:xdgBase "XDG_DATA_HOME" ; ws:fallback ".local/share" ; ws:relativePath "snshah/snshah.ts" .
ws:path-theme a ws:XdgPath ; ws:name "theme" ; ws:xdgBase "XDG_DATA_HOME" ; ws:fallback ".local/share" ; ws:relativePath "snshah/snshah.omp.json" .
ws:path-receipt a ws:XdgPath ; ws:name "receipt" ; ws:xdgBase "XDG_STATE_HOME" ; ws:fallback ".local/state" ; ws:relativePath "snshah/installed.auto.json" .
ws:path-downloads a ws:XdgPath ; ws:name "downloads" ; ws:xdgBase "XDG_CACHE_HOME" ; ws:fallback ".cache" ; ws:relativePath "snshah" .
ws:path-bin a ws:XdgPath ; ws:name "bin" ; ws:xdgBase "XDG_BIN_HOME" ; ws:fallback ".local/bin" ; ws:relativePath "snshah" .
